CONFIG_IDF_TARGET="esp32s3"

# Full speed for the policy math
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Finer vTaskDelay granularity (the control loop itself runs off a hardware timer)
CONFIG_FREERTOS_HZ=1000

# WiFi + HTTP server make the app ~1 MB, which doesn't fit the default 1 MB
# app partition. The large single-app table has a 1.5 MB app partition and
# still fits in 2 MB of flash. Set the real flash size if the module has more.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Web interface: WebSocket for logs, telemetry and commands
CONFIG_HTTPD_WS_SUPPORT=y

# Keep the whole network stack on core 0; core 1 is reserved for control
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
